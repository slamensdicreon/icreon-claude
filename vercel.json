{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "claude/bold-euler-i3qm3k": false
    }
  },
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "vite",
      "installCommand": "pnpm install --frozen-lockfile --filter @lw/web...",
      "buildCommand": "pnpm build",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            }
          ]
        },
        {
          "source": "/assets/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    },
    "api": {
      "root": "./",
      "entrypoint": "Dockerfile.api"
    }
  },
  "rewrites": [
    {
      "source": "/projects",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/projects/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/auth/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/playbooks",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/playbooks/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/intake/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/integrations/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/portfolio",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/portfolio/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/rules",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/rules/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/knowledge",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/knowledge/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/proposals/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/cypher",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/cypher/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/connections",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/connections/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/me",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/me/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/admin/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/organization",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/organization/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/health",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "daemons": {
    "worker": {
      "root": "./",
      "entrypoint": "Dockerfile.worker",
      "instances": {
        "iad1": 1
      },
      "resources": {
        "requests": {
          "memory": "4Gi"
        }
      },
      "terminationGracePeriodSeconds": 300
    }
  },
  "crons": [
    {
      "path": "/portfolio/watchdog",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/portfolio/purge-due",
      "schedule": "41 7 * * *"
    }
  ]
}
